# Neon pooled connection (app runtime)
# Plain postgresql:// is auto-upgraded to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.azure.neon.tech/neondb?sslmode=require

# Neon direct connection (Alembic migrations; omit -pooler from hostname)
DATABASE_URL_DIRECT=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxx.region.azure.neon.tech/neondb?sslmode=require

# OpenAI-compatible embeddings + chat
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=openai
# Timeweb requires provider prefix, e.g. openai/text-embedding-3-small
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=deepseek/deepseek-v4-flash
# Hard timeout for Timeweb/OpenAI requests (seconds)
OPENAI_TIMEOUT_SEC=30
OPENAI_MAX_RETRIES=1
# If embedding hangs or returns wrong dims, try: EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_SEND_DIMENSIONS=true

# Uploads / OCR / LibreOffice
MAX_UPLOAD_SIZE_MB=25
OCR_LANGUAGES=rus+eng
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_SEC=60

# App
APP_ENV=dev
LOG_LEVEL=INFO
